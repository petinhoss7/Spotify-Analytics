# Copy this file to .env and fill in your credentials.
# Never commit the real .env file.

# Spotify API (via RapidAPI)
SPOTIFY_CLIENT_ID=your_client_id
SPOTIFY_CLIENT_SECRET=your_client_secret

# Last.fm API
LASTFM_API_KEY=your_lastfm_api_key

# MusicBrainz (identify your application, see https://musicbrainz.org/doc/MusicBrainz_API)
MUSICBRAINZ_USER_AGENT=spotify-analytics/1.0.0 (your-email@example.com)

# OpenRouter (LLM classification layer L4 in scripts/classifier)
OPENROUTER_API_KEY=your_openrouter_api_key
L4_MODEL=z-ai/glm-5.3-flash

# Optional: override the DuckDB path used by the extract scripts
# DUCKDB_PATH=data/spotify.duckdb
